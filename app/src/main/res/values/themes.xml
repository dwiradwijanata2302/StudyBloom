<!-- res/values/themes.xml -->
<resources>

    <style name="Theme.StudyBloom" parent="Theme.Material3.Light.NoActionBar">

        <!-- Warna utama -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Warna sekunder -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Status bar warna mengikuti background -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Shape global untuk Card dan tombol (override di bawah) -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.StudyBloom.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.StudyBloom.Large</item>

    </style>

    <!-- Shape: Card biasa -->
    <style name="ShapeAppearance.StudyBloom.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Shape: Card besar / bottom sheet -->
    <style name="ShapeAppearance.StudyBloom.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Shape: Tombol pill (full rounded) -->
    <style name="ShapeAppearance.StudyBloom.Pill" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Style tombol utama (primary button) -->
    <style name="Widget.StudyBloom.Button.Primary" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.StudyBloom.Pill</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- Style tombol outline (secondary button, misal tombol Delete) -->
    <style name="Widget.StudyBloom.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.StudyBloom.Pill</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- Style Card standar StudyBloom -->
    <style name="Widget.StudyBloom.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Style Card besar (misal Continue Learning card di Dashboard) -->
    <style name="Widget.StudyBloom.Card.Large" parent="Widget.StudyBloom.Card">
        <item name="cardCornerRadius">24dp</item>
    </style>

</resources>