<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background">

    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="@dimen/spacing_2xl"
        android:scaleType="centerInside"
        android:src="@drawable/ic_studybloom_logo"
        android:contentDescription="StudyBloom Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:textAppearance="@style/TextAppearance.StudyBloom.Display"
        android:text="StudyBloom" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_3xl"
        android:textAppearance="@style/TextAppearance.StudyBloom.Body.Medium"
        android:text="Build Better Learning Habits" />

    <ProgressBar
        android:id="@+id/progressLoading"
        style="?attr/progressBarStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/primary" />

</LinearLayout>